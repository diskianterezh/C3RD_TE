

@rep_window_x = 675
@rep_window_y = 600


message_window = {
	name = "c3rd_rep_tension_window"
	size = { @rep_window_x @rep_window_y }
	position = { 531 150 }
	movable = yes

	state = {
		name = _show
		start_sound = {
			soundeffect = "event:/SFX/UI/Generic/2.0/sfx_ui_window_tab_close"
		}
	}
	state = {
		name = _hide
		start_sound = {
			soundeffect = "event:/SFX/UI/Generic/2.0/sfx_ui_window_tab_close"
		}
	}
	
	icon = {
		texture = "gfx/interface/event_window/Event_dagger_behind_back.dds"
		visible = "[GetScriptedGui('c3rd_monetary_is_normal').IsShown( GuiScope.SetRoot( Player.MakeScope ).End )]"
		scale = 0.45
		alpha = 1
		parentanchor = top|center
		position = { 0 20 }
	}
	margin_widget = {
		parentanchor = center
		name = "data1"
		size = { 600 70 }
		using = NoninteractableBG
		position = { 0 -70 }
		blockoverride "Margins"
		{
			margin = { 0 0 }
		}
	}
	
	flowcontainer = {
		parentanchor = center
		position = { 10 -80 }
		spacing = 0
		direction = horizontal
		icon_and_text = {
			size = { 210 0 }
			scale = 0.7
			blockoverride "Text" { 
				text = "c3rd_rep_size"
				scale = 1.1
			}
			blockoverride "Icon" { 
				texture = "gfx/interface/icons/shared_icons/city.dds" 
			}
			tooltip = "c3rd_rep_src_cities_tt"
			
		}
		icon_and_text = {
			size = { 150 0 }
			scale = 0.7
			blockoverride "Text" { 
				text = "c3rd_rep_stab" 
				scale = 1.2
			}
			blockoverride "Icon" { texture = "gfx/interface/icons/shared_icons/stability.dds" }
			tooltip = "c3rd_rep_src_stab_tt"
			
		}
		icon_and_text = {
			size = { 150 0 }
			scale = 0.7
			blockoverride "Text" { 
				text = "c3rd_rep_senate_approval" 
				scale = 1.2
			}
			blockoverride "Icon" { texture = "gfx/interface/icons/modifiers/senate_approval.dds" }
			tooltip = "c3rd_rep_src_low_senate_tt"
			
		}
		
	}

	flowcontainer = {
		parentanchor = center
		position = { 10 -50 }
		spacing = 0
		direction = horizontal
		icon_and_text = {
			size = { 190 0 }
			scale = 0.7
			blockoverride "Text" { 
				text = "c3rd_rep_time" 
				scale = 1.1
			}
			blockoverride "Icon" { texture = "gfx/interface/icons/shared_icons/time.dds" }
			tooltip = "c3rd_rep_time_tt"
			
		}
		icon_and_text = {
			size = { 170 0 }
			scale = 0.7
			blockoverride "Text" { 
				text = "c3rd_rep_monetary" 
				scale = 1.2
			}
			blockoverride "Icon" { 
				texture = "gfx/interface/icons/shared_icons/leader.dds" 
				scale = 1.1
			}
			tooltip = "c3rd_rep_monetary_tt"
			
		}
		icon_and_text = {
			size = { 150 0 }
			scale = 0.7
			visible = "[GetScriptedGui('c3rd_monetary_enslaved_culture').IsValid( GuiScope.SetRoot( Player.MakeScope ).End )]"
			blockoverride "Text" { 
				text = "c3rd_rep_military" 
				scale = 1.2
			}
			blockoverride "Icon" { texture = "gfx/interface/icons/shared_icons/military_tradition.dds" }
			tooltip = "c3rd_rep_military_tt"
			
		}
		
	}


	blockoverride "Title_text" { text = "c3rd_rep_tension_window_TITLE" }

	blockoverride "White_buttons"
	{
		button_close = {
			tooltip = "CLOSE"
			onclick = "[ExecuteConsoleCommand('gui.ClearWidgets c3rd_rep_tension_window')]"
			onclick = "[GetVariableSystem.Clear('c3rd_rep_tension_window_opened')]"
		}
	}
	
	
			vbox = {
				name = "Tension tab"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 25 250 }


				margin_widget = { #Unique Mechanics for Republic
					size = { 0 528 }
					layoutpolicy_horizontal = expanding
					margin_top = 12
					hbox = {
						margin = { 200 0 }
						layoutpolicy_horizontal = expanding
						spacing = 10
						parentanchor = top|hcenter
						position = { 0 -190 }
						
						icon = {
							size = { 35 35 }
							visible = "[GetScriptedGui('c3rd_divided_empire').IsShown( GuiScope.SetRoot( Player.MakeScope ).End )]"
							texture = "gfx/interface/icons/shared_icons/reputation.dds"
							tooltip = "c3rd_rep_divided_empire_tt"
							color = { 0.5 1 0.5 1 }
						}
						icon = {
