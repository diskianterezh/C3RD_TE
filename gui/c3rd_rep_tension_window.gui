					}
					margin_widget = {
						size = { 150 276 }
						position = { -0 40 }
						margin = { 2 25 }
						allow_outside = yes
						
						icon_card = {
							blockoverride "Icon" {}
							datacontext = "[Player.MakeScope.GetVariable('c3rd_rep_tension_leader').GetCharacter]"
							size = { 100% 100% }
							#visible = "[Player.MakeScope.HasVariable('c3rd_rep_tension_leader')]"
							tooltip = "c3rd_rep_dangerous_leader_tt"
							tag = {
								parentanchor = hcenter
								position = { 0 10 }
								scale = 0.8
								text = "c3rd_dangerous_leader_text"

							}
							icon_and_text = {
								size = { 70 0 }
								scale = 1
								position = { -5 50 }
								parentanchor = hcenter
								blockoverride "Icon"
								{
									texture = "gfx/interface/icons/shared_icons/loyalty.dds"
									tooltip = "[Character.GetLoyaltyToolTip]"
									framesize = { 50 50 }
									size = { 34 34 }
								}
								blockoverride "Text" { text = "[Character.GetLoyalty|0]" }
								visible = "[GetScriptedGui('c3rd_rep_char_norm').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
							}
							icon_and_text = {
								size = { 70 0 }
								scale = 1
								position = { -5 50 }
								parentanchor = hcenter
								blockoverride "Icon"
								{
									texture = "gfx/interface/icons/shared_icons/popularity.dds"
									framesize = { 50 50 }
									size = { 34 34 }
								}
								blockoverride "Text" { text = "[Character.GetPopularity|0]" }
								tooltip = "[Character.GetPopularityToolTip]"
								visible = "[GetScriptedGui('c3rd_rep_char_ruler').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
							}
							cpt_button = {
								parentanchor = hcenter
								position = { 0 102 }
								size = { 60 90 }
								blockoverride "ShowIcons" { visible = no }
								blockoverride "PortraitTexture" { portrait_texture = "[Character.GetPortrait('default', 'head')]" }

							}
						}
						icon = {
							texture = "gfx/interface/tiles/senate_frame.dds"
							size = { 158 240 }
							datacontext = "[Player.MakeScope.GetVariable('c3rd_rep_tension_leader').GetCharacter]"
							spriteType = corneredtiled
							spriteborder = { 65 65 }
							position = { 0 -8 }
							parentanchor = hcenter
							visible = "[GetScriptedGui('c3rd_rep_char_polinf').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
						}

					}
					flowcontainer = {
						parentanchor = top|right
						position = { -10 70 }
						spacing = 50
						direction = vertical
						icon_button_square = {
							size = { 40 40 }
							position = { 0 0 }
							tooltip = "[GetScriptedGui('c3rd_start_monarch_reform').BuildTooltip( GuiScope.SetRoot( Player.MakeScope ).End )]"
							enabled = "[GetScriptedGui('c3rd_start_monarch_reform').IsValid( GuiScope.SetRoot( Player.MakeScope ).End )]"
							
							blockoverride "ClickSound" { clicksound = "event:/SFX/UI/Actions/sfx_ui_action_goverment_interactions" }
			
							blockoverride "Icon" { 
