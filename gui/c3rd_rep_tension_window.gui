							position = { 0 0 }
							tooltip = "[GetScriptedGui('c3rd_split_the_empire').BuildTooltip( GuiScope.SetRoot( Player.MakeScope ).End )]"
							enabled = "[GetScriptedGui('c3rd_split_the_empire').IsValid( GuiScope.SetRoot( Player.MakeScope ).End )]"
			
							blockoverride "ClickSound" { clicksound = "event:/SFX/UI/Actions/sfx_ui_action_goverment_interactions" }
			
							blockoverride "Icon" { 
								texture = "gfx/interface/icons/governor_policies/civilization_effort.dds" 
								scale = 1					
							}
							blockoverride "On_click"
							{
								onclick = "[GetScriptedGui('c3rd_split_the_empire').Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"
							}
						}
						icon_button_square = {
							size = { 40 40 }
							position = { 0 0 }
							tooltip = "[GetScriptedGui('c3rd_convocatio_populi').BuildTooltip( GuiScope.SetRoot( Player.MakeScope ).End )]"
							enabled = "[GetScriptedGui('c3rd_convocatio_populi').IsValid( GuiScope.SetRoot( Player.MakeScope ).End )]"
			
							blockoverride "ClickSound" { clicksound = "event:/SFX/UI/Actions/sfx_ui_action_goverment_interactions" }
			
							blockoverride "Icon" { 
